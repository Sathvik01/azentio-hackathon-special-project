{
  "name": "azentio-portal",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "setup": "docker compose up -d --wait && prisma db push && prisma db seed",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "demo:reset": "prisma db push --force-reset && prisma db seed",
    "test": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:acceptance": "vitest run tests/acceptance"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@langchain/core": "^1.3.2",
    "@langchain/openai": "^1.8.0",
    "@prisma/client": "^6.19.3",
    "motion": "^14.9.0",
    "next": "^15.5.28",
    "next-auth": "^5.0.0-beta.32",
    "nodemailer": "^6.10.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "postcss": "^8.5.32",
    "prisma": "^6.19.3",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
