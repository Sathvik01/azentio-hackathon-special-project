# --- Local infrastructure (docker compose) ---
DATABASE_URL="postgresql://azentio:azentio@localhost:5433/azentio?schema=public"

# --- Auth.js ---
# Any long random string; regenerate with: npx auth secret
AUTH_SECRET="change-me-to-a-long-random-string"
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST=true
EMAIL_SERVER="smtp://localhost:1025"
EMAIL_FROM="azentio.ai <no-reply@azentio.local>"
MAILPIT_URL="http://localhost:8025"

# --- AIRA (any OpenAI-compatible endpoint; default = NVIDIA build.nvidia.com free API) ---
AI_BASE_URL="https://integrate.api.nvidia.com/v1"
AI_API_KEY=""
AI_CHAT_MODEL="nvidia/nemotron-3.5-lightning-30b-a3b"

# --- Governance ---
MIN_COHORT_ORGS=3
AI_ASSIST_MODERATION=false
